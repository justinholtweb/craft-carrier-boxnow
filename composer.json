{
    "name": "justinholtweb/craft-carrier-boxnow",
    "description": "BOX NOW parcel lockers (Greece, Cyprus, Bulgaria, Croatia, Slovenia) for Carrier — locker picker, labels, COD and tracking.",
    "version": "5.1.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "carrier",
        "shipping",
        "boxnow",
        "lockers",
        "greece",
        "croatia"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-carrier",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-carrier/docs/boxnow",
        "source": "https://github.com/justinholtweb/craft-carrier-boxnow",
        "issues": "https://github.com/justinholtweb/craft-carrier-boxnow/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.3.0",
        "justinholtweb/craft-carrier": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\carrierboxnow\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Carrier for BOX NOW",
        "handle": "carrier-boxnow",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-carrier/docs/boxnow",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-carrier-boxnow/main/CHANGELOG.md",
        "class": "justinholtweb\\carrierboxnow\\Plugin"
    }
}
